# Demo env for a Monaco Geofabrik extract (not the planet). Copy values are local-only.

OSM_DOMAIN=localhost
ACME_EMAIL=demo@localhost
OSM_TOKEN=demo-monaco-token-change-me
DATA_DIR=/workspace/data
THREADS=2
NOMINATIM_PASSWORD=demo-nominatim

# Host-download target (Geofabrik Monaco). Overpass wants .osm.bz2; demo-up converts the pbf.
EXTRACT_PBF_URL=https://download.geofabrik.de/europe/monaco-latest.osm.pbf
EXTRACT_BZ2_URL=

# Kept for compose variable interpolation; unused in demo overlay.
OVERPASS_PLANET_URL=file:///planet-src/extract.osm.bz2
PLANET_URL=
REPLICATION_URL=
PMTILES_DOWNLOAD_URL=
