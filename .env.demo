# "planet" here is this box's region (Monaco). COMPOSE_FILE selects the HTTP overlay.
COMPOSE_FILE=docker-compose.yml:docker-compose.demo.yml
DATA_DIR=./data
THREADS=2
OSM_TOKEN=demo-monaco-token-change-me
NOMINATIM_PASSWORD=demo-nominatim
PLANET_URL=https://download.geofabrik.de/europe/monaco-latest.osm.pbf
OVERPASS_PLANET_URL=file:///planet-src/planet.osm.bz2
REPLICATION_URL=
OSM_DOMAIN=localhost
ACME_EMAIL=demo@localhost
PMTILES_DOWNLOAD_URL=
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAINTENANCE_WORK_MEM=1GB
POSTGRES_AUTOVACUUM_WORK_MEM=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
