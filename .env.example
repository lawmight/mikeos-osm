# Copy to .env and fill in. Keep .env out of git (see .gitignore).

# Public hostname that points (A record) at this box — Caddy gets a TLS cert for it.
OSM_DOMAIN=osm.example.com
ACME_EMAIL=you@example.com

# Long random shared secret the app sends as: Authorization: Bearer <OSM_TOKEN>
#   generate with: openssl rand -hex 32
OSM_TOKEN=change-me-to-a-long-random-token

# NVMe mount holding all service data (Nominatim DB, Overpass DB, OSRM files). Needs ~1.5 TB+.
DATA_DIR=/data

# Import parallelism — set to the box's core count (Ryzen 9 5950X = 16).
THREADS=16

# Nominatim's internal Postgres password.
NOMINATIM_PASSWORD=change-me

# Planet source + replication (minute diffs). Use a fast mirror if planet.osm.org is slow.
# Nominatim + OSRM read the .pbf; OVERPASS reads a .osm.bz2 (it pipes it through bunzip2).
PLANET_URL=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf
OVERPASS_PLANET_URL=https://planet.openstreetmap.org/planet/planet-latest.osm.bz2
REPLICATION_URL=https://planet.openstreetmap.org/replication/minute/

# Basemap tiles: a Protomaps planet PMTiles daily build (served at tiles.osmike.com). Pick a recent
# dated build from https://maps.protomaps.com/builds (retained ~7 days).
PMTILES_DOWNLOAD_URL=https://build.protomaps.com/20260723.pmtiles
