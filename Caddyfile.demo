# Demo gateway: plain HTTP. Same Bearer gate as production, plus a public /showcase page.

:80 {
	encode gzip

	handle /showcase* {
		root * /srv/showcase
		uri strip_prefix /showcase
		file_server
	}

	@unauth {
		not path /showcase*
		not header Authorization "Bearer {$OSM_TOKEN}"
	}
	handle @unauth {
		respond "unauthorized" 401
	}

	handle_path /nominatim/* {
		reverse_proxy nominatim:8080 {
			header_up -Accept
		}
	}
	handle_path /overpass/* {
		reverse_proxy overpass:80 {
			header_up -Accept
		}
	}
	handle_path /route/* {
		reverse_proxy osrm:5000
	}
	handle {
		respond "mikeos-osm demo: /nominatim /overpass /route /showcase/" 200
	}
}
