# Copy to .env and fill in. Keep .env out of git (see .gitignore).

# Public hostname that points (A record) at this box — Caddy gets a TLS cert for it.
OSM_DOMAIN=osm.example.com
ACME_EMAIL=you@example.com

# Long random shared secret the app sends as: Authorization: Bearer <OSM_TOKEN>
#   generate with: openssl rand -hex 32
OSM_TOKEN=change-me-to-a-long-random-token

# NVMe mount holding all service data (Nominatim DB, Overpass DB, OSRM files). Needs ~1.5 TB+.
DATA_DIR=/data

# Import parallelism — set to the box's core count (Ryzen 9 5950X = 16).
THREADS=16

# Nominatim's internal Postgres password.
NOMINATIM_PASSWORD=change-me

# Planet source + replication (minute diffs).
#
#   RULE: planet files are downloaded ONCE, ON THE HOST — never inside a container. A container that
#   owns its download re-pulls the whole planet on every failed init (this burned us repeatedly).
#   Download on the host, then point each service at the LOCAL file:
#
#     bash scripts/host-download.sh https://planet.openstreetmap.org/planet/planet-latest.osm.bz2 /data/planet-src/planet.osm.bz2
#     bash scripts/host-download.sh https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf     /data/planet-src/planet.osm.pbf
#
#   Overpass reads a .osm.bz2 (it bunzip2's it); Nominatim + OSRM read the .pbf. /data/planet-src is
#   mounted read-only into the containers as /planet-src.
OVERPASS_PLANET_URL=file:///planet-src/planet.osm.bz2   # local file, mounted from /data/planet-src
PLANET_URL=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf   # host-download target (OSRM/Nominatim)
REPLICATION_URL=https://planet.openstreetmap.org/replication/minute/

# Basemap tiles: a Protomaps planet PMTiles daily build (served at tiles.osmike.com). Pick a recent
# dated build from https://maps.protomaps.com/builds (retained ~7 days).
PMTILES_DOWNLOAD_URL=https://build.protomaps.com/20260723.pmtiles
